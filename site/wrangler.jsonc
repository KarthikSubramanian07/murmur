// Publishes this folder at murmur.afig.dev as a Cloudflare Worker with static assets (#111).
// `npx wrangler deploy` from this folder; the custom domain makes Cloudflare create the DNS
// record and certificate in the afig.dev zone.
{
  "name": "murmur-site",
  "compatibility_date": "2026-11-01",
  "main": "src/worker.js",
  // The Worker answers these before the assets do: `/` to serve markdown to an agent that asks for
  // it, the agent pages (no asset has their paths), the videos (src/worker.js says why), and the
  // check-ins and the page that counts them (src/usage.js).
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/*.mp4", "/setup", "/setup.md", "/join", "/join.md", "/use", "/use.md",
      "/v1/*", "/stats", "/stats/*"]
  },
  // src/worker.js imports docs/agents/*.md as text, its copy for when GitHub can't be reached, and
  // src/usage.js imports the stats page.
  "rules": [{ "type": "Text", "globs": ["**/*.md", "src/*.html"], "fallthrough": true }],
  // The daily check-ins (#148). `npx wrangler d1 migrations apply murmur-usage --remote` applies
  // migrations/ to it. The stats page's key is the STATS_KEY secret (`npx wrangler secret put`).
  "d1_databases": [
    { "binding": "DB", "database_name": "murmur-usage", "database_id": "178820d5-4536-4e57-90bc-4591131e3e0a" }
  ],
  "routes": [{ "pattern": "murmur.afig.dev", "custom_domain": true }],
  // No murmur-site.<account>.workers.dev, but a preview URL for each `npx wrangler versions upload`,
  // so a change is tried on Cloudflare before it is deployed (#140).
  "workers_dev": false,
  "preview_urls": true
}
